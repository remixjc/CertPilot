<Window x:Class="CertPilot.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CertPilot · 证书管理" Width="1260" Height="830" MinWidth="1040" MinHeight="720" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#E1EAE2" BorderThickness="0,0,0,1" Padding="28,0"><DockPanel LastChildFill="True"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Border Background="#226D53" CornerRadius="9" Width="36" Height="38"><TextBlock Text="C" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/></Border><TextBlock Text="CertPilot" FontSize="25" FontWeight="SemiBold" Margin="12,0,16,0"/><TextBlock Text="WINDOWS DESKTOP" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right"><TextBlock x:Name="AccountLabel" Text="本机证书工作台" Foreground="{StaticResource Muted}" Margin="0,0,20,0"/><Button x:Name="RefreshButton" Content="刷新" Click="Refresh_Click" IsEnabled="False"/><Button x:Name="LogoutButton" Content="退出登录" Click="Logout_Click" Visibility="Collapsed"/></StackPanel></DockPanel></Border>
  <Grid Grid.Row="1" Margin="26,24,26,14">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border x:Name="Notice" CornerRadius="6" Background="#E9F2E9" Padding="14,10" Margin="0,0,0,15" Visibility="Collapsed"><TextBlock x:Name="NoticeText"/></Border>
   <Grid Grid.Row="1">
    <Grid x:Name="LoginPanel">
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="#123D2D" CornerRadius="12" Margin="0,0,24,0" Padding="40"><Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="CERTIFICATES, ON AUTOPILOT" Foreground="#A5C1A9" FontSize="11" Margin="0,0,0,24"/><TextBlock Text="证书管理，&#10;从桌面开始。" Foreground="White" FontSize="38" FontWeight="SemiBold" LineHeight="58"/><TextBlock Text="原生 WPF 管理端连接 Windows 后台服务。&#10;关闭窗口、注销桌面，续期依然继续。" Foreground="#A5C1A9" FontSize="14" Margin="0,25,0,0" LineHeight="26"/></StackPanel><TextBlock Text="Windows Service  /  Web API  /  Native WPF" VerticalAlignment="Bottom" Foreground="#7EAA8C" FontSize="11"/></Grid></Border>
     <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="18,18,18,18"><TextBlock Text="连接管理服务" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="首次使用先安装服务，再读取本机初始账号。" Foreground="{StaticResource Muted}" Margin="0,0,0,22"/><TextBlock Text="服务地址" Style="{StaticResource Label}"/><TextBox x:Name="EndpointBox" AutomationProperties.AutomationId="Endpoint" Margin="0,0,0,16"/><TextBlock Text="本机数据目录（用于读取初始账号与管理证书）" Style="{StaticResource Label}"/><TextBox x:Name="DataDirectoryBox" Margin="0,0,0,16"/><TextBlock Text="用户名" Style="{StaticResource Label}"/><TextBox x:Name="UsernameBox" Text="admin" AutomationProperties.AutomationId="Username" Margin="0,0,0,16"/><TextBlock Text="密码" Style="{StaticResource Label}"/><PasswordBox x:Name="LoginPassword" AutomationProperties.AutomationId="Password" Margin="0,0,0,24" KeyDown="Password_KeyDown"/><StackPanel Orientation="Horizontal" Margin="0,0,0,18"><Button Content="登录工作台 →" Style="{StaticResource Primary}" Click="Login_Click" AutomationProperties.AutomationId="Login"/><Button Content="读取初始账号" Click="Bootstrap_Click"/></StackPanel><WrapPanel Margin="0,8,0,0"><Button Content="安装 / 更新本机服务" Click="Install_Click"/><Button Content="启动本机服务" Click="StartService_Click"/></WrapPanel><TextBlock Text="默认仅本机 HTTPS。自签名管理连接只接受本机数据目录中完全匹配的实例证书。安装会请求管理员权限。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,20,0,0" LineHeight="20"/></StackPanel></ScrollViewer>
    </Grid>
    <Grid x:Name="Workspace" Visibility="Collapsed">
     <TabControl x:Name="Sections" SelectionChanged="Section_Changed" BorderThickness="0" Background="Transparent">
      <TabItem Header="证书管理" x:Name="CertificatesTab"><Grid Margin="0,22,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <DockPanel Margin="0,0,0,18"><StackPanel DockPanel.Dock="Left"><TextBlock Text="证书管理" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="StatsLabel" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel><Button x:Name="NewCertificateButton" Content="＋ 新建证书" Style="{StaticResource Primary}" Click="NewCertificate_Click" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
       <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><Grid><DataGrid x:Name="CertificateGrid" SelectionChanged="Certificate_Changed" MouseDoubleClick="Certificate_DoubleClick" AutomationProperties.AutomationId="CertificateList"><DataGrid.Columns><DataGridTemplateColumn Header="证书 / 域名" Width="2.3*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding DomainText}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="实际状态" Binding="{Binding StateText}" Width="*"/><DataGridTextColumn Header="有效期至" Binding="{Binding ExpiryText}" Width="1.5*"/><DataGridTextColumn Header="自动续期" Binding="{Binding RenewalText}" Width="*"/><DataGridTextColumn Header="CA 环境" Binding="{Binding EnvironmentText}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock x:Name="EmptyCertificates" Text="暂无托管证书。点击“新建证书”配置域名与验证方式。" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" IsHitTestVisible="False"/></Grid></Border>
       <StackPanel Grid.Row="2" Margin="0,18,0,0"><WrapPanel x:Name="CertificateActions" IsEnabled="False"><Button Content="查看详情" Click="Details_Click"/><Button x:Name="EditCertificateButton" Content="编辑配置" Click="EditCertificate_Click"/><Button x:Name="IssueButton" Content="申请证书" Style="{StaticResource Primary}" Click="Issue_Click"/><Button x:Name="RenewButton" Content="立即续期" Click="Renew_Click"/><Button x:Name="ToggleButton" Content="暂停 / 恢复续期" Click="Toggle_Click"/><Button x:Name="InspectButton" Content="网站检测" Click="Inspect_Click"/><Button x:Name="RemoveButton" Content="停止托管" Click="Remove_Click" Foreground="#B15B4A"/></WrapPanel><TextBlock Text="证书签发成功后，仍需部署到 IIS / Nginx。网站检测可检查实际呈现的证书。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,18,0,0"/></StackPanel>
      </Grid></TabItem>
      <TabItem Header="DNS 凭据" x:Name="CredentialsTab"><Grid Margin="0,22,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,22"><StackPanel><TextBlock Text="DNS 凭据" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Cloudflare DNS-01 授权，密钥加密保存在服务端，不回传原文。" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel><Button Content="＋ 添加凭据" Style="{StaticResource Primary}" Click="NewCredential_Click" HorizontalAlignment="Right"/></DockPanel><Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="CredentialGrid" AutomationProperties.AutomationId="CredentialList"><DataGrid.Columns><DataGridTextColumn Header="凭据名称" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Zone 域名" Binding="{Binding ZoneName}" Width="*"/><DataGridTextColumn Header="Zone ID" Binding="{Binding ZoneId}" Width="2*"/><DataGridTextColumn Header="修订" Binding="{Binding Revision}" Width="80"/></DataGrid.Columns></DataGrid></Border><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,0"><Button Content="替换所选 Token" Click="UpdateCredential_Click"/><TextBlock Text="权限限定为该 Zone 的 DNS Edit，通配符必须使用 DNS-01。" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Grid></TabItem>
      <TabItem Header="任务记录"><Grid Margin="0,22,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="160"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,18"><TextBlock Text="任务记录" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="最近 100 项。任务由 Windows 服务持久执行，不依赖桌面窗口保持打开。" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel><Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="JobGrid" SelectionChanged="Job_Changed"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding CreatedText}" Width="1.6*"/><DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="*"/><DataGridTextColumn Header="阶段" Binding="{Binding Stage}" Width="*"/><DataGridTextColumn Header="证书 ID" Binding="{Binding CertificateId}" Width="2*"/></DataGrid.Columns></DataGrid></Border><TextBox Grid.Row="2" x:Name="JobDetails" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0" Text="选择任务查看错误或实际执行结果。" FontFamily="Consolas, Microsoft YaHei UI"/></Grid></TabItem>
      <TabItem Header="本机服务与连接"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,22,0,0"><TextBlock Text="本机服务与连接" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,20"/><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Windows 系统服务 · CertPilot" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="LocalServiceLabel" Text="正在检测…" Foreground="{StaticResource Muted}" Margin="0,10,0,18"/><WrapPanel><Button Content="安装 / 更新本机服务" Click="Install_Click"/><Button Content="启动" Click="StartService_Click"/><Button Content="停止" Click="StopService_Click"/><Button Content="刷新本机状态" Click="LocalService_Click"/></WrapPanel><TextBlock Text="这里的安装、启动和停止操作作用于当前 Windows 电脑。停止服务会同时停止 Web API 与自动续期。" Foreground="{StaticResource Muted}" Margin="0,16,0,0" FontSize="11"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="当前连接" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="ConnectionLabel" Margin="0,12,0,16"/><WrapPanel><Button Content="打开 Web 管理端" Click="OpenWeb_Click"/><Button Content="打开 API 文档" Click="OpenApi_Click"/><Button Content="打开本机数据目录" Click="OpenData_Click"/><Button Content="编辑本机服务配置" Click="OpenConfig_Click"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="后台运行状态" FontSize="16" FontWeight="SemiBold"/><TextBox x:Name="SystemDetails" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Margin="0,16,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
     </TabControl>
    </Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="#EDF3EC" Padding="28,0"><DockPanel><TextBlock Text="CertPilot · 原生 WPF 管理端" Foreground="{StaticResource Muted}" FontSize="11" DockPanel.Dock="Left"/><TextBlock x:Name="StatusLabel" Text="关闭管理端不会停止 Windows 服务" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11"/></DockPanel></Border>
  <Border x:Name="BusyOverlay" Background="#70F5F8F5" Grid.RowSpan="3" Visibility="Collapsed"><Border Background="White" CornerRadius="9" Padding="30,22" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="正在处理，请稍候…" FontSize="16"/></Border></Border>
 </Grid>
</Window>
